data/processed/*
!data/processed/.gitkeep

# Common data-file formats
*.xlsx
*.xls
*.csv
*.parquet
*.feather
*.pickle
*.pkl

# Microsoft Word documents and templates stay local (case-insensitive extensions)
*.[dD][oO][cC]
